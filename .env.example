SECRET_KEY=generate-a-random-secret-value
GOVERNMENT_USERNAME=your-government-admin-email
GOVERNMENT_PASSWORD=use-a-unique-strong-password
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Local development uses SQLite and local photos by default.
# On Render, set DATABASE_URL to the Postgres internal connection URL.
DATABASE_URL=

# Set PHOTO_STORAGE_MODE=r2 only after configuring the R2 bucket and S3 credentials.
PHOTO_STORAGE_MODE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The Render web service should use external mode after a separate worker is created.
AI_ANALYSIS_WORKER_MODE=inline
